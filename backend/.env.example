# Application
APP_NAME=LumenGrid
APP_ENV=development
DEBUG=true
SANDBOX_MODE=true

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./lumengrid.db
# DATABASE_URL=postgresql://user:password@localhost:5432/lumengrid

# Nokia Network as Code (NaC) credentials
NAC_API_URL=https://network-as-code.p-eu.rapidapi.com
NAC_CLIENT_ID=your_client_id
NAC_CLIENT_SECRET=your_client_secret
NAC_RAPIDAPI_KEY=your_rapidapi_key

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8083

# OpenCelliD — download Greater Tunis cells (scripts/download_ooredoo_towers.py)
OPENCELLID_API_KEY=
